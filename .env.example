# ============================================================
# Data Catalog Platform — Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values:
#
#   cp .env.example .env
#
# Lines starting with # are comments and are ignored.
# Never commit your actual .env file to Git.
# ============================================================


# ── Google Cloud / BigQuery ──────────────────────────────────
# Your GCP project ID (find it in https://console.cloud.google.com)
GCP_PROJECT=my-data-platform

# BigQuery dataset name (created via: bq mk --dataset my-data-platform:data_catalog)
BQ_DATASET=data_catalog

# Path to your GCP service account key file
# Create one at: GCP Console → IAM → Service Accounts → Keys
# Required roles: BigQuery Data Editor, BigQuery Job User
GOOGLE_APPLICATION_CREDENTIALS=/path/to/your/service-account-key.json


# ── JWT / Auth ───────────────────────────────────────────────
# Generate a strong secret with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=REPLACE_WITH_256BIT_SECRET_FROM_SECRET_MANAGER

# Token lifetimes (Zero Trust: keep access tokens short)
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=1


# ── Kafka ────────────────────────────────────────────────────
# For local docker-compose — do not change
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Kafka topic names
KAFKA_TOPIC_RAW_METADATA=raw-metadata-events
KAFKA_TOPIC_ENRICHED_METADATA=enriched-metadata-events
KAFKA_TOPIC_AUDIT=audit-events


# ── Redis ────────────────────────────────────────────────────
# For local docker-compose — do not change
REDIS_URL=redis://redis:6379


# ── Open Policy Agent (OPA) ──────────────────────────────────
# For local docker-compose — do not change
OPA_URL=http://opa:8181


# ── Service-to-service URLs ──────────────────────────────────
# These are used inside the Docker network — do not change
# unless you're running services outside Docker.
AUTH_SERVICE_URL=http://auth-service:8006
CATALOG_SERVICE_URL=http://catalog-service:8005
CLASSIFICATION_SERVICE_URL=http://classification-service:8003
TERM_SERVICE_URL=http://term-service:8004
AUDIT_SERVICE_URL=http://audit-service:8007
LINEAGE_SERVICE_URL=http://lineage-service:8008


# ── DataHub ──────────────────────────────────────────────────
# URL of your DataHub GMS instance
# For local DataHub quickstart: datahub docker quickstart
DATAHUB_GMS_URL=http://datahub-gms:8080

# Optional: DataHub personal access token
# Generate at: DataHub UI → Settings → Access Tokens
DATAHUB_TOKEN=

# Set to false in POC/dev mode to skip live DataHub HTTP calls
DATAHUB_ENABLED=true


# ── Logging ──────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
# Use DEBUG during development, INFO in production
LOG_LEVEL=INFO


# ── POC / Local Dev mode ─────────────────────────────────────
# Switch catalog-service and audit-service from BigQuery → SQLite.
# Set to "sqlite" for local POC, "bigquery" for production.
CATALOG_BACKEND=bigquery

# Path to the SQLite catalog database (only used when CATALOG_BACKEND=sqlite)
SQLITE_DB_PATH=/poc-data/catalog.db


# ── Monitoring ───────────────────────────────────────────────
# Grafana admin credentials (change before exposing externally)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin123

# Alertmanager — Slack webhook for alert notifications
# Create one at: https://api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Alertmanager — PagerDuty integration key
# Find it in: PagerDuty → Services → Integrations → Events API v2
PAGERDUTY_INTEGRATION_KEY=YOUR_PAGERDUTY_KEY


# ── Production / Kubernetes ──────────────────────────────────
# GKE cluster details (only needed for kubectl / CI-CD deploys)
GKE_CLUSTER=data-catalog-prod
GKE_REGION=us-central1
NAMESPACE=data-catalog

# GCR image registry
GCR_REGISTRY=gcr.io/my-data-platform

# GitHub Actions Workload Identity (set in GitHub repo secrets, not here)
# GCP_WORKLOAD_IDENTITY_PROVIDER=projects/123.../providers/github-provider
# GCP_SERVICE_ACCOUNT=github-actions@my-data-platform.iam.gserviceaccount.com
